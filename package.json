{
  "name": "wiki-plugin-slowbutton",
  "version": "0.1.1",
  "description": "Federated Wiki plugin — a button that estimates how long its action takes, shades itself with progress, reverses in red on overrun, and learns from previous runs",
  "keywords": [
    "wiki",
    "federated wiki",
    "plugin",
    "button",
    "progress",
    "estimate"
  ],
  "author": {
    "name": "David Bovill",
    "url": "https://github.com/Hitchhikers-Guide-to-the-Galaxy"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "client",
    "factory.json",
    "pages"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-slowbutton.git"
  },
  "bugs": {
    "url": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-slowbutton/issues"
  },
  "homepage": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-slowbutton#readme",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "build": "npm run clean && npm run test && node --no-warnings scripts/build-client.js",
    "dev": "node --no-warnings scripts/build-client.js --watch",
    "clean": "rm -f client/slowbutton.js client/slowbutton.js.map",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
